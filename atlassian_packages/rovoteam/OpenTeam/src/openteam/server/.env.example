# Copy to .env and fill in your credentials.
# Used by create_role, role_setup tools (RovoChatInferencer auth).
#
# Auth priority: ROVOCHAT_* checked first, falls back to JIRA_* / ATLASSIAN_*.
# Pick ONE auth method below.

# --- Basic Auth (recommended — simplest) ---
ROVOCHAT_EMAIL=your-email@company.com
ROVOCHAT_API_TOKEN=your-atlassian-api-token
ROVOCHAT_BASE_URL=https://your-site.atlassian.net

# --- UCT token ---
# ROVOCHAT_UCT_TOKEN=your-uct-token

# --- ASAP credentials ---
# ROVOCHAT_ASAP_ISSUER=your-issuer
# ROVOCHAT_ASAP_PRIVATE_KEY=your-private-key
# ROVOCHAT_ASAP_KEY_ID=your-key-id
