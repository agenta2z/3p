# BTA config for create_role — produces a Role Responsibility Document.
#
# Usage:
#   import agent_foundation.common.configs.registered_targets
#   from rich_python_utils.config_utils import load_config, instantiate
#   bta = instantiate(load_config("create_role_bta.yaml", overrides={...}))
#   result = await bta.ainfer("Senior Backend Engineer focused on microservices")

_target_: BTA

# =====================================================================
# Shared config (auto-injected into all children via _-prefix convention)
# =====================================================================
_logger: auto
_debug_mode: true  # enables verbose logging (CacheOpen, Async, RetryPrompt etc.)
_template_manager:
  _target_: TemplateManager
  templates:
    - ${oc.env:PROMPT_TEMPLATES_DIR,prompt_templates}
    - ${modpath:agent_foundation.resources.prompt_templates}
  active_template_type: main
  predefined_variables: true
  cross_root_variable_lookup: true   # Refactor 17: framework wrappers + consumer specialized variants
  default_template_key: initial
  enable_templated_feed: true

# =====================================================================
# Pipeline: inferencers
# =====================================================================

# --- Breakdown ---
# template_root_space: task_breakdown defaulted by BTA.SLOT_DEFAULTS.
breakdown_inferencer:
  _target_: RovoChat
  auto_continue: true
  output_path: "breakdown_output.md"   # _finalize_output() writes <Response> content here
                                        # → children/breakdown/outputs/breakdown_output.md
  max_continuations: 5
  template_variables:
    task_preamble: create_role

# --- Workers (homogeneous — single partial, all same type) ---
worker_factory:
  _target_: RovoChat
  auto_continue: true
  max_continuations: 5
  template_root_space: deep_research
  output_path: "facet.md"
  response_post_processor: extract_delimited
  template_variables:
    task_preamble: create_role

# --- Aggregator ---
# Use RovoDevCLI (not RovoChat) for aggregation:
# - RovoDevCLI can write large documents to local files (via --output-file)
# - Returns clean file content as output (not just streaming text)
# - RovoChat cannot write local files, so the synthesized document was
#   being lost (agent said "written to file" but it never actually was)
aggregator_inferencer:
  # task_preamble + task_response_format = aggregation defaulted by BTA.SLOT_DEFAULTS;
  # task_instructions: create_role overrides the default per-key (the
  # create_role-specific instructions matter more than generic aggregation here).
  _target_: RovoDevCLI
  yolo: true
  debug_mode: true
  config_override: '{"agent": {"modelId": "anthropic:claude-opus-4-6"}}'
  template_root_space: plan
  output_path: "role_document.md"
  response_post_processor: extract_delimited
  template_variables:
    task_instructions: create_role

# =====================================================================
# Pipeline: settings
# =====================================================================
breakdown_format: json_subtasks
worker_query_fields:
  - description
  - todos
max_breakdown: 8
debug_mode: true
output_path: "role_document.md"
