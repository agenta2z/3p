{
  "name": "slack_search_messages",
  "tool_type": "Action",
  "category": "utility",
  "description": "Search Slack messages using the Slack Web API search.messages endpoint.",
  "parameters": [
    {
      "name": "query",
      "type": "string",
      "required": true,
      "positional": true,
      "description": "Search query for Slack messages."
    },
    {
      "name": "--count",
      "type": "int",
      "default": 20,
      "description": "Maximum number of results (1-100)."
    },
    {
      "name": "--sort_dir",
      "type": "string",
      "default": "desc",
      "choices": ["asc", "desc"],
      "description": "Sort direction for results."
    }
  ],
  "returns": "JSON with ok, total, matches (list of message objects), and paging info.",
  "examples": [
    "slack_search_messages \"deployment issues\"",
    "slack_search_messages \"from:@tony design review\" --count 10 --sort_dir asc"
  ]
}
