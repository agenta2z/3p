        "submission_templates_loader.py",
        "task_types.py",
        "tool_call_parser.py",
        "tool_executor.py",
        "workflow_context.py",
    ],
    visibility = ["//rankevolve/..."],
    deps = [
        "fbsource//third-party/pypi/pyyaml:pyyaml",
        ":llm_clients",
        "//rankevolve/src/agentic_foundation:agentic_foundation",
        "//rankevolve/src/cli/cli_shared:cli_shared",  # @manual -- resource files (config, prompts, templates) loaded by shared_loader.py
        "//rankevolve/src/common:common_streaming",
        "//rankevolve/src/integrations/fblearner:fblearner",
        "//rankevolve/src/resources:tools",
        # Reference script library — submission_templates_loader resolves
        # template IDs via importlib.resources from this resources target.
        "//rankevolve/src/utils:utils",
        # tool_executor._exec_aggregator_only_refresh lazy-imports
        # chatbot_demo_react.backend.services.{learnings_archive,
        # learnings_generator}; without this dep the import fails at
        # runtime with ModuleNotFoundError and the slash command silently
        # returns an error wrapped in a COMMAND_RESPONSE envelope.
        # `:agent_service` is a leaf (no back-edge to server_lib),
        # so adding it here is acyclic.
    ],
)

