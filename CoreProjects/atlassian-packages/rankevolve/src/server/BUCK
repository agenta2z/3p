# One-shot migration: backfill role='task_ref' rows into existing
# session_state.json files so resumed sessions show task chips inline
# at their original conversation positions (instead of clustered at the
# bottom). Stop the agent server before running.
python_binary(
    name = "migrate_session_task_refs",
    srcs = ["migrate_session_task_refs.py"],
    main_function = "rankevolve.src.server.migrate_session_task_refs.main",
)

# One-shot migration: move task workspaces from flat <server>/tasks/ to
# per-session <server>/sessions/<session>/tasks/ and rewrite the absolute
# paths persisted in every session_state.json. Stop the agent server
# before running. Supports --dry-run.
python_binary(
    name = "migrate_tasks_per_session",
    srcs = ["migrate_tasks_per_session.py"],
    main_function = "rankevolve.src.server.migrate_tasks_per_session.main",
)

