load("@fbcode_macros//build_defs:python_binary.bzl", "python_binary")
load("@fbcode_macros//build_defs:python_library.bzl", "python_library")

oncall("ads_ranking_features")

# LLM client libraries (base, anthropic, openai, plugboard)
# Extracted to break the dependency cycle between server_lib and agentic_foundation.
python_library(
    name = "llm_clients",
    srcs = glob(["llm/**/*.py"]),
    visibility = ["//rankevolve/..."],
    deps = [
        "fbsource//third-party/pypi/anthropic:anthropic",
        "fbsource//third-party/pypi/openai:openai",
        "//ai_productivity/plugboard/if:plugboard-if-python-clients",
        "//ai_productivity/plugboard/if:plugboard-if-python-types",
        "//ai_productivity/plugboard/if:stream_defs-python-types",
        "//c2p/secure_thrift/python:client",
        "//configerator/structs/infrasec/if:acl-python-types",
        "//crypto/cat/py:corp_crypto_auth_token_util",
    ] + select({
        "DEFAULT": [],
        "ovr_config//os:linux": [
            "//servicerouter/client/python:async_client",
            "//servicerouter/client/python:client_params",
        ],
    }),
)

# Core business logic (moved from chat_cli) + command routing
